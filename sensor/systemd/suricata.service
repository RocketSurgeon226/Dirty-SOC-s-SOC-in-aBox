[Unit]
Description=Suricata IDS (SOC-in-a-Box, SPAN mode)
After=socbox-capture@eth0.service
Requires=socbox-capture@eth0.service

[Service]
ExecStart=/usr/bin/suricata -c /etc/suricata/suricata.yaml --af-packet=eth0 --pidfile /run/suricata.pid
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure

[Install]
WantedBy=multi-user.target