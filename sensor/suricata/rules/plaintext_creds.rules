# Owner: Adam — Custom rules for HTTP Basic Auth and plaintext login form POSTs.

alert http $HOME_NET any -> any any (msg:"SOCBOX Plaintext HTTP Basic Auth"; \
flow:established,to_server; \
http.request_header; content:"Authorization|3a| Basic"; \
nocase; \
classtype:policy-violation; \
sid:9000001; rev:1;)

alert http $HOME_NET any -> any any ( \
    msg:"SOCBOX Plaintext login form POST"; \
    flow:established,to_server; \
    http.method; content:"POST"; \
    http.request_body; pcre:"/(?:pass|pwd)/i"; \
    lua: plaintext_creds.lua; \
    classtype:policy-violation; \
    sid:9000002; rev:1;)